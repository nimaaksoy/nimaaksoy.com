{
  "manifest_version": 3,
  "name": "Nima Aksoy Today",
  "version": "1.0.0",
  "description": "A local-first daily new tab dashboard with calendar, Persian dates, Toman currency, private note, Radar, Prompts, and latest news.",
  "permissions": ["storage"],
  "host_permissions": ["https://nimaaksoy.com/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "offline_enabled": true
}
